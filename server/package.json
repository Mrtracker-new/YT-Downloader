{
  "name": "youtube-downloader-backend",
  "version": "1.0.0",
  "description": "Backend API for YouTube video downloader",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r ./src/register src/app.ts\"",
    "build": "tsc",
    "start": "node -r ./dist/register dist/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["youtube", "downloader", "api", "express"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression":        "^1.8.0",
    "cors":               "^2.8.5",
    "dotenv":             "^16.5.0",
    "express":            "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet":             "^8.0.0",
    "joi":                "^17.13.3",
    "sanitize-filename":  "^1.6.3",
    "typescript":         "^5.8.3",
    "uuid":               "^11.1.0",
    "winston":            "^3.17.0"
  },
  "devDependencies": {
    "@types/compression":        "^1.7.5",
    "@types/cors":               "^2.8.17",
    "@types/express":            "^4.17.21",
    "@types/jest":               "^29.5.14",
    "@types/node":               "^20.17.32",
    "@types/uuid":               "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser":        "^8.31.1",
    "eslint":    "^9.25.1",
    "jest":      "^29.7.0",
    "nodemon":   "^3.1.10",
    "prettier":  "^3.5.3",
    "supertest": "^7.1.0",
    "ts-jest":   "^29.3.2",
    "ts-node":   "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm":  ">=9.0.0"
  }
}
